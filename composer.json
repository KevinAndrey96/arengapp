{
    "name": "kevinandrey96/php-arengapp-protest-audio-archive",
    "description": "Archive and web player of 42 protest chants from the 2019-2021 social mobilizations in Colombia, in framework-free PHP 8.3+.",
    "type": "project",
    "license": "MIT",
    "keywords": ["php", "audio-player", "archive", "colombia", "paro-nacional", "protest", "seo"],
    "authors": [
        {
            "name": "Kevin Andrey Herrera Silva",
            "email": "kahs_kevin@hotmail.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Arengapp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Arengapp\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "lint": "php-cs-fixer check --diff",
        "fix": "php-cs-fixer fix",
        "check": ["@lint", "@analyse", "@test"]
    }
}
